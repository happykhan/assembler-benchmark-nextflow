params.container_runtime = 'singularity'
singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = "--bind ${projectDir}:${projectDir},${launchDir}:${launchDir},${new File(params.cache_dir.toString()).absolutePath}:${new File(params.cache_dir.toString()).absolutePath}${params.container_bind_paths ? ','+params.container_bind_paths.toString() : ''}"
process {
    withName: /PREPARE_INPUT|ASSEMBLE|ASSESS/ {
        container = "${new File(params.cache_dir.toString()).absolutePath}/images/${params.container_image.tokenize(':')[-1]}.sif"
    }
}
