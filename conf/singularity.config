// The same OCI runtime is converted to SIF and cached by Nextflow.
singularity.enabled = true
singularity.autoMounts = true
process.container = "docker://${params.container_image}"
singularity.runOptions = "--bind ${projectDir}:${projectDir}"
singularity.envWhitelist = 'http_proxy,https_proxy,ftp_proxy,no_proxy,HTTP_PROXY,HTTPS_PROXY,FTP_PROXY,NO_PROXY'
