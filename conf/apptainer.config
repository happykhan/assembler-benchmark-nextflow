apptainer.enabled = true
apptainer.autoMounts = true
process.container = "docker://${params.container_image}"
apptainer.runOptions = "--bind ${projectDir}:${projectDir},${launchDir}:${launchDir},${params.reference_dir}:${params.reference_dir},${params.read_cache}:${params.read_cache}"
apptainer.envWhitelist = 'http_proxy,https_proxy,ftp_proxy,no_proxy,HTTP_PROXY,HTTPS_PROXY,FTP_PROXY,NO_PROXY'
