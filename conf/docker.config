// Digest-pinned Pixi runtime; scientific packages use environments/pixi.lock.
docker.enabled = true
process.container = params.container_image
docker.runOptions = "-v ${projectDir}:${projectDir}"
docker.envWhitelist = 'http_proxy,https_proxy,ftp_proxy,no_proxy,HTTP_PROXY,HTTPS_PROXY,FTP_PROXY,NO_PROXY'
