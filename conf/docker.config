params.container_runtime = 'docker'
docker.enabled = true
docker.runOptions = "-v ${projectDir}:${projectDir} -v ${launchDir}:${launchDir} -v ${new File(params.cache_dir.toString()).absolutePath}:${new File(params.cache_dir.toString()).absolutePath}" + (params.offline ? ' --network none' : '')
process {
    withName: /PREPARE_INPUT|ASSEMBLE|ASSESS/ { container = params.container_image }
}
