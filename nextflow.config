manifest {
    name = 'assembler-benchmark-nextflow'
    version = '0.2.0-beta'
    nextflowVersion = '>=25.10.2'
}
params {
    help = false
    preset = null
    collections = ''
    scenarios = ''
    cases = ''
    workflows = ''
    all = false
    catalogue = "${projectDir}/assets/catalogue.json"
    cache_dir = "${launchDir}/cache"
    outdir = "${launchDir}/results/current"
    plan_only = false
    prepare_only = false
    results_only = false
    render_only = false
    pilot_reports = false
    rerun = false
    offline = false
    bootstrap_python = 'python3'
    network_blocker = null
    runtime = 'pixi'
    container_bind_paths = ''
    container_runtime = null
    container_image = 'ghcr.io/prefix-dev/pixi@sha256:702f3a3c966aa63a0a57906466ec33ce9a463b532446f5584498fa429d069fd8'
}
process {
    executor = 'local'
    cpus = 1
    memory = '4 GB'
    time = '30 min'
    errorStrategy = 'finish'
    maxRetries = 0
    cache = 'deep'
}
executor.queueSize = 1000
env.BENCH_RUNTIME = params.runtime
env.BENCH_OFFLINE = params.offline ? '1' : '0'
env.PIXI_CACHE_DIR = "${projectDir}/environments/.pixi/cache"
env.BENCH_PIXI_MANIFEST = "${projectDir}/environments/pixi.toml"
profiles {
    native_tools {
        params.runtime = 'native'
        env.BENCH_RUNTIME = 'native'
    }
    local { process.executor = 'local' }
    slurm { process.executor = 'slurm' }
    bmrc {
        params.container_bind_paths = '/well'
        process.executor = 'slurm'
        process.queue = 'short'
        process.clusterOptions = '--account=aanensen.prj'
    }
    transfer_host {
        process {
            withName: ADMIT_INPUT { executor = 'local' }
        }
    }
    pixi { params.runtime = 'pixi'; env.BENCH_RUNTIME = 'pixi' }
    docker { includeConfig 'conf/docker.config' }
    singularity { includeConfig 'conf/singularity.config' }
    apptainer { includeConfig 'conf/apptainer.config' }
}
trace {
    enabled = true
    file = "${launchDir}/nextflow-trace.tsv"
    overwrite = true
}
