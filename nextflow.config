manifest {
    name = 'assembler-benchmark-nextflow'
    version = '0.1.0'
    nextflowVersion = '>=25.10.2'
}
params {
    preset = 'quick'
    plan = null
    groups = ''
    cases = ''
    assemblers = 'flye,raven'
    outdir = 'results/quick'
    reference_dir = "${projectDir}/references"
    offline = false
    run_id = 'quick-development'
    runtime = 'native'
    container_image = 'assembler-benchmark:0.1.0'
}
process {
    executor = 'local'
    cpus = 2
    memory = '4 GB'
    time = '30 min'
    errorStrategy = 'terminate'
    maxRetries = 0
    cache = 'deep'
}
executor.queueSize = 1000
env.BENCH_RUNTIME = params.runtime
env.BENCH_PIXI_MANIFEST = "${projectDir}/environments/pixi.toml"
profiles {
    local { process.executor = 'local' }
    slurm { process.executor = 'slurm' }
    bmrc {
        process.executor = 'slurm'
        process.queue = 'short'
        process.clusterOptions = '--account=aanensen.prj'
    }
    pixi {
        params.runtime = 'pixi'
        env.BENCH_RUNTIME = 'pixi'
    }
    docker {
        docker.enabled = true
        process.container = params.container_image
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.container = "docker://${params.container_image}"
    }
}
trace {
    enabled = true
    file = "${params.outdir}/nextflow-trace.tsv"
    overwrite = true
}
